[Unit]
Description=Gunicorn instance to serve 15 Night Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/15night/backend
Environment="PATH=/var/www/15night/backend/.venv/bin"
ExecStart=/var/www/15night/backend/.venv/bin/gunicorn app.main:app -w 4 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:8001

[Install]
WantedBy=multi-user.target